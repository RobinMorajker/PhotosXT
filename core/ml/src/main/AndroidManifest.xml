<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The eraser models download on first use (spec §4.10). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- Play services fetches these ML Kit models when the app is installed (spec §5.8). -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="face,ocr,ocr_devanagari,subject_segment" />
    </application>
</manifest>
