<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: nothing goes to cloud backup or device-to-device transfer. Caches rebuild from
    MediaStore and Drive, Drive metadata stays on this device (spec §5.7), the vault's key never
    leaves the Keystore, and settings restore through the user's Drive app-data folder (spec §4.8).
    android:allowBackup="false" covers Android 11.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="device_root" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="device_root" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
